{
  "name": "asignaturas",
  "displayName": "Asignaturas",
  "description": "Panel lateral para saltar entre las carpetas de tus asignaturas abriendo cada una como workspace",
  "version": "1.0.0",
  "publisher": "izandegeer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "asignaturas",
          "title": "Asignaturas",
          "icon": "media/birrete.svg"
        }
      ]
    },
    "views": {
      "asignaturas": [
        {
          "id": "asignaturas.lista",
          "name": "Asignaturas"
        }
      ]
    },
    "commands": [
      {
        "command": "asignaturas.abrir",
        "title": "Abrir asignatura"
      },
      {
        "command": "asignaturas.refrescar",
        "title": "Refrescar",
        "icon": "$(refresh)"
      },
      {
        "command": "asignaturas.elegirCarpeta",
        "title": "Elegir carpeta de asignaturas",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "asignaturas.elegirCarpeta",
          "when": "view == asignaturas.lista",
          "group": "navigation"
        },
        {
          "command": "asignaturas.refrescar",
          "when": "view == asignaturas.lista",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "asignaturas.abrir",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Asignaturas",
      "properties": {
        "asignaturas.root": {
          "type": "string",
          "default": "",
          "description": "Carpeta que contiene una subcarpeta por asignatura. Admite ~ para la carpeta personal."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "asignaturas.lista",
        "contents": "Elige la carpeta donde tienes una subcarpeta por asignatura (por ejemplo \"DWS - Desarrollo Web Entorno Servidor\").\n[Elegir carpeta](command:asignaturas.elegirCarpeta)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/izandegeer/vscode-asignaturas"
  },
  "files": [
    "extension.js",
    "media/",
    "LICENSE"
  ]
}
