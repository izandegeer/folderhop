{
  "name": "folderhop",
  "displayName": "FolderHop",
  "description": "%description%",
  "version": "2.0.0",
  "publisher": "izandegeer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/izandegeer/folderhop"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "folders",
    "workspace",
    "switch",
    "projects",
    "carpetas"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "folderhop",
          "title": "FolderHop",
          "icon": "media/pipe.svg"
        }
      ]
    },
    "views": {
      "folderhop": [
        {
          "id": "folderhop.list",
          "name": "%view.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "folderhop.list",
        "contents": "%welcome%"
      }
    ],
    "commands": [
      {
        "command": "folderhop.open",
        "title": "%command.open%"
      },
      {
        "command": "folderhop.chooseRoot",
        "title": "%command.chooseRoot%",
        "category": "FolderHop",
        "icon": "$(folder-opened)"
      },
      {
        "command": "folderhop.refresh",
        "title": "%command.refresh%",
        "category": "FolderHop",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "folderhop.chooseRoot",
          "when": "view == folderhop.list",
          "group": "navigation"
        },
        {
          "command": "folderhop.refresh",
          "when": "view == folderhop.list",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "folderhop.open",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "FolderHop",
      "properties": {
        "folderhop.root": {
          "type": "string",
          "default": "",
          "description": "%config.root%"
        }
      }
    }
  },
  "files": [
    "extension.js",
    "media/",
    "l10n/",
    "package.nls*.json",
    "LICENSE"
  ]
}
